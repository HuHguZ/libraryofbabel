# Copy to .env.local and use long, random values for both secrets.
# Generate each with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DATABASE_URL=postgres://babel:babel@localhost:5433/babel
GUEST_SECRET=
ADMIN_TOKEN=
WS_PORT=3001
# Set when browsers reach the WebSocket server through a proxy.
# NEXT_PUBLIC_WS_URL=wss://example.org/ws
# Enable only behind a reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY=1
